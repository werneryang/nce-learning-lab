[
  {
    "id": "EX000001",
    "chunkId": "CH000001",
    "text": "The room got quiet when the presentation began.",
    "provenance": "project_original"
  },
  {
    "id": "EX000002",
    "chunkId": "CH000002",
    "text": "Please pay attention to the road signs.",
    "provenance": "project_original"
  },
  {
    "id": "EX000003",
    "chunkId": "CH000003",
    "text": "I turned around to wave at my neighbor.",
    "provenance": "project_original"
  },
  {
    "id": "EX000004",
    "chunkId": "CH000004",
    "text": "In the end, we chose the quieter cafe.",
    "provenance": "project_original"
  },
  {
    "id": "EX000005",
    "chunkId": "CH000005",
    "text": "A polite alternative is: I would rather keep that private.",
    "provenance": "project_original"
  },
  {
    "id": "EX000006",
    "chunkId": "CH000006",
    "text": "On Sundays, we cook lunch together.",
    "provenance": "project_original"
  },
  {
    "id": "EX000007",
    "chunkId": "CH000007",
    "text": "I get up early when I have a morning walk.",
    "provenance": "project_original"
  },
  {
    "id": "EX000008",
    "chunkId": "CH000008",
    "text": "She stayed in bed to rest her ankle.",
    "provenance": "project_original"
  },
  {
    "id": "EX000009",
    "chunkId": "CH000009",
    "text": "Just then, the delivery driver called.",
    "provenance": "project_original"
  },
  {
    "id": "EX000010",
    "chunkId": "CH000010",
    "text": "We looked out of the train window at the hills.",
    "provenance": "project_original"
  },
  {
    "id": "EX000011",
    "chunkId": "CH000011",
    "text": "Please send your teammate the updated schedule.",
    "provenance": "project_original"
  },
  {
    "id": "EX000012",
    "chunkId": "CH000012",
    "text": "Maya lent her neighbor a ladder.",
    "provenance": "project_original"
  },
  {
    "id": "EX000013",
    "chunkId": "CH000013",
    "text": "We made a decision to travel by train.",
    "provenance": "project_original"
  },
  {
    "id": "EX000014",
    "chunkId": "CH000014",
    "text": "I spent an hour organizing my photos.",
    "provenance": "project_original"
  },
  {
    "id": "EX000015",
    "chunkId": "CH000015",
    "text": "The repair took the whole day.",
    "provenance": "project_original"
  },
  {
    "id": "EX000016",
    "chunkId": "CH000016",
    "text": "I have been to the new community library.",
    "provenance": "project_original"
  },
  {
    "id": "EX000017",
    "chunkId": "CH000017",
    "text": "A great number of volunteers joined the clean-up.",
    "provenance": "project_original"
  },
  {
    "id": "EX000018",
    "chunkId": "CH000018",
    "text": "There is a small garden in the centre of the courtyard.",
    "provenance": "project_original"
  },
  {
    "id": "EX000019",
    "chunkId": "CH000019",
    "text": "My cousin works for a local design studio.",
    "provenance": "project_original"
  },
  {
    "id": "EX000020",
    "chunkId": "CH000020",
    "text": "The volunteer carried a message to the reception desk.",
    "provenance": "project_original"
  },
  {
    "id": "EX000021",
    "chunkId": "CH000021",
    "text": "We covered a short distance before stopping for water.",
    "provenance": "project_original"
  },
  {
    "id": "EX000022",
    "chunkId": "CH000022",
    "text": "She sent a request for a larger meeting room.",
    "provenance": "project_original"
  },
  {
    "id": "EX000023",
    "chunkId": "CH000023",
    "text": "We labeled each box. In this way, everyone could find the supplies.",
    "provenance": "project_original"
  },
  {
    "id": "EX000024",
    "chunkId": "CH000024",
    "text": "So far, three neighbors have joined our reading group.",
    "provenance": "project_original"
  }
]
